# =============================================================================
# NDA Assistant — backend configuration
# Copy to `.env` and edit. Every value has a safe default (see app/config.py); the app boots with
# NONE of these set. This file is the local mirror of docs/CREDENTIALS.md — keep them in sync.
#
# Convention: a variable's ABSENCE disables the capability it unlocks (a feature turns off politely);
# it is never a boot error. Lines are commented out = the app uses the default shown.
# =============================================================================

# ---- Environment -----------------------------------------------------------
# APP_ENV drives the logging defaults below. One of: dev | prod | test. Default: dev.
APP_ENV=dev

# ---- Logging ---------------------------------------------------------------
# LOG_LEVEL: standard Python level name. Default: DEBUG when APP_ENV=dev, else INFO.
# LOG_FORMAT: console (human-readable) | json (one object per line, for aggregation).
#             Default: console when APP_ENV=dev, else json.
# LOG_LEVEL=INFO
# LOG_FORMAT=json

# ---- Telemetry export → Azure Application Insights -------------------------
# Unlocks capability: telemetry_export.
# When set, traces/logs/metrics export to Azure Monitor (App Insights). When absent, the capability
# is DISABLED (a clean no-op) — never an error. Format: the App Insights connection string.
# APPLICATIONINSIGHTS_CONNECTION_STRING=

# ---- Persistence -----------------------------------------------------------
# SQLite by default (a single file under DATA_DIR; zero infra for dev/tests). Prod points this at
# Postgres. A bare `postgres://` or `postgresql://` URL is normalized to `postgresql+psycopg2://`.
# DATABASE_URL=sqlite:///./data/app.db
# DATA_DIR=./data
# MAX_UPLOAD_MB=25

# ---- AI provider: OpenRouter (primary; ZDR-pinned — PLAN §3.8) --------------
# Unlocks capability: llm_inference. When the key is set, ALL engine review/router calls route
# through the OpenRouter adapter; when absent, the direct-Anthropic fallback below is used instead
# (and with neither key, /v1 reviews answer 503 no_provider).
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# ZDR routing policy (PLAN §6, fail closed): every request carries provider preferences
# {data_collection:'deny', zdr:true, allow_fallbacks:false}. A model with no ZDR-qualifying route
# FAILS (OpenRouter: "no providers available") — it is never silently downgraded to a non-ZDR route.
# OPENROUTER_ZDR_ONLY=true
# Optional per-request provider pinning: comma-separated OpenRouter provider slugs sent as
# provider.only (e.g. "anthropic"). Blank = any route satisfying the ZDR policy. Pinning also
# disables fallbacks, even when OPENROUTER_ZDR_ONLY=false.
# OPENROUTER_PROVIDER_ONLY=
# DEEP-tier provider pin (defaults to google-vertex): opus-4-8's default ZDR route (Amazon Bedrock)
# rejects the json_schema response_format and 400s every deep review; Vertex serves it with ZDR AND
# accepts json_schema. Blank = fall back to OPENROUTER_PROVIDER_ONLY.
# OPENROUTER_PROVIDER_ONLY_DEEP=google-vertex
# Per-tier model ids, vendor-namespaced as OpenRouter expects. Tiers mirror the direct-Anthropic
# gateway exactly: deep reviewer / quick reviewer / T0 doc-classifier router.
# OPENROUTER_MODEL_REVIEW_DEEP=anthropic/claude-opus-4-8
# OPENROUTER_MODEL_REVIEW_QUICK=anthropic/claude-sonnet-4-6
# OPENROUTER_MODEL_ROUTER=anthropic/claude-haiku-4-5
# BYOK note: attaching your own Anthropic key to OpenRouter (so your own ZDR contract governs
# inference; 5% fee beyond 1M req/mo) is configured on the OpenRouter DASHBOARD (account-level),
# not per request — there is no env var for it. Reported usage cost stays authoritative either way.

# ---- AI provider: Anthropic (configuration fallback adapter) ----------------
# The ported direct-Anthropic gateway stays available as a per-alias fallback (PLAN §3.8).
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6
# ANTHROPIC_MAX_TOKENS=1024

# ---- Engine (/v1 API) ------------------------------------------------------
# ENGINE_API_KEY: when set, /v1 endpoints require a matching X-API-Key (binds to principal svc:default).
# ENGINE_SERVICE_KEYS: extra comma-separated "name:secret" pairs -> principal "svc:<name>".
# ENGINE_REQUIRE_KEY: prod-only; refuse to serve /v1 (503) when NO usable key is configured (fail closed).
# ENGINE_API_KEY=
# ENGINE_SERVICE_KEYS=
# ENGINE_REQUIRE_KEY=false
# ENGINE_PLAYBOOK_PATH=              # blank = repo playbook build
# ENGINE_STANDARD_TEMPLATE_PATH=     # blank = repo standard template
# ENGINE_RATE_LIMIT_PER_MIN=0        # per-principal sliding-window request cap; 0 disables
# ENGINE_MONTHLY_COST_CAP_USD=0.0    # per-principal calendar-month spend cap (soft); 0 disables
# PROVIDER_TIMEOUT_S=150             # per-call provider timeout (seconds)
# REVIEW_CONCURRENCY=3               # max PAID reviews in flight per process (429 review_capacity beyond)
# PROMPT_CACHE_1H_DEEP=false         # deep/Opus prefix uses a 1h prompt-cache TTL instead of 5m
# SIM_CACHE_ENABLED=true             # serve a stored review for a textually-identical re-submission
# REDIS_URL=                         # shared rate-limit store for MULTI-REPLICA deploys; blank = in-process

# ---- Document ingestion: PDF extract + local OCR ---------------------------
# PDF_EXTRACT_STRATEGY: how a PDF source is rebuilt as editable text. "local" (PyMuPDF) is the only value.
# OCR_* : fully-local, zero-egress OCR fallback for scanned/image-only PDFs.
# PDF_EXTRACT_STRATEGY=local
# OCR_ENABLED=true
# OCR_BACKEND=auto                   # auto | tesseract | apple | paddle
# OCR_DPI=300
# OCR_LANG=eng
# OCR_TESSDATA_DIR=                  # blank = system default
# OCR_MAX_PAGES=60
# OCR_ESCALATE=true
# OCR_MIN_QUALITY=0.70
# OCR_MIN_TOKENS_FOR_QUALITY=25
# OCR_FALLBACK_BACKEND=              # blank = auto (apple if available, else paddle)

# ---- Display rendering (non-PDF uploads) -----------------------------------
# LibreOffice headless renders .docx/.doc/.odt/.rtf/.txt into a faithful display PDF.
# SOFFICE_BIN=soffice
# SOFFICE_TIMEOUT=90.0

# ---- Playbook embeddings (escalate-only substrate; default OFF) ------------
# EMBEDDINGS_PROVIDER: off | voyage | fake. With "off" every embed call is a no-op.
# EMBEDDINGS_PROVIDER=off
# VOYAGE_API_KEY=
# EMBEDDINGS_MODEL=voyage-law-2
# EMBED_PLAYBOOK_INDEX_PATH=playbook/v4/embeddings.npz
# EMBED_COV_THRESHOLD=0.60
# EMBED_TRIGGER_THRESHOLD=0.70

# ---- Secrets at rest -------------------------------------------------------
# Optional Fernet key (urlsafe base64, 32 bytes) encrypting secrets stored in app_settings.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SETTINGS_ENCRYPTION_KEY=

# ---- Bootstrap admin (first run) -------------------------------------------
# On first boot with ZERO admins, an admin is auto-created (must_change_password=True). Blank = skip.
# ROTATE/CLEAR after the first login.
# ADMIN_BOOTSTRAP_USER_ID=
# ADMIN_BOOTSTRAP_PASSWORD=

# ---- API / CORS ------------------------------------------------------------
# CORS_ORIGINS: exact allowed origins (comma-separated) for credentialed CORS (wildcards invalid).
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# HOST=0.0.0.0
# PORT=8000
# TRUST_FORWARDED_PROTO=true         # honour X-Forwarded-Proto: https behind a trusted TLS edge

# ---- Auth IP throttle (credential-stuffing / reset-spam mitigation) --------
# AUTH_IP_THROTTLE_ENABLED=true
# AUTH_IP_MAX_ATTEMPTS=20            # failed logins per IP per window before 429
# AUTH_RESET_IP_MAX=5                # reset-request calls per IP per window before 429
# AUTH_IP_WINDOW_S=300               # shared sliding-window size (seconds)

# ---- Admin IP allowlist (optional gate on /admin — PLAN §6) ----------------
# IPs and/or CIDRs (comma/space/semicolon separated) allowed to reach /admin. EMPTY = allow all (the
# gate is a transparent pass-through). X-Forwarded-For is trusted ONLY behind a trusted edge
# (TRUST_FORWARDED_PROTO); otherwise the direct socket peer is used. Seed via the admin UI at cutover.
# ADMIN_IP_ALLOWLIST=203.0.113.4,198.51.100.0/24

# ---- Bot: Slack (capability: slack — PLAN §3.3) ----------------------------
# Unlocks capability: slack (the in-process Bolt surface: events + interactivity). BOTH keys are
# required; absent => the Slack channel is DISABLED (politely off), never a boot error.
# SLACK_BOT_TOKEN=                   # xoxb-… bot OAuth token (Slack Web API)
# SLACK_SIGNING_SECRET=              # v0 HMAC verification of inbound events/interactivity (fail-closed)
# NDA_BOT_USER_ID=                   # the bot's own Slack user id (human-event guard drops its own msgs)
# NDA_BOT_FROM_EMAIL=nda-bot@example.com   # the bot's From address on outbound email

# ---- Bot: Email intake / IMAP (capability: email_in — PLAN §3.3) -----------
# Unlocks capability: email_in (the worker polls UNSEEN mail). host+user+password required.
# IMAP_HOST=
# IMAP_PORT=993                      # IMAPS (implicit TLS)
# IMAP_USER=
# IMAP_PASSWORD=
# IMAP_FOLDER=INBOX

# ---- Bot: Email delivery / SMTP (capability: email_out — PLAN §3.3) --------
# Unlocks capability: email_out (threaded replies + attachments). host+user+password required.
# SMTP_HOST=
# SMTP_PORT=587                      # submission (STARTTLS); 465 = implicit TLS (set SMTP_SECURE=true)
# SMTP_SECURE=false                  # implicit TLS on connect (true for 465; false for STARTTLS on 587)
# SMTP_USER=
# SMTP_PASSWORD=

# ---- Bot: Admin routing & sender policy (PLAN §3.4, §3.3) ------------------
# Where allowlist-miss approval requests are announced, and the email-trust gate.
# NDA_ADMIN_SLACK_CHANNEL=           # admin channel id for pending-approval notifications
# NDA_ADMIN_EMAIL=                   # admin email for pending-approval notifications
# EMAIL_REQUIRE_DMARC=true           # require SPF/DKIM/DMARC alignment before an email sender is trusted
# BOT_INBOX_SWEEP_SECONDS=30         # worker sweep cadence for stuck/failed bot_inbox rows (recovery)

# ---- Tally intake (capability: tally — PLAN §3.6) ---------------------------
# The NDA intake form lives on Tally (the in-house /f form service was retired). The bot's generate
# intent hands out a channel-prefilled link; on submit Tally POSTs a signed webhook to
# /integrations/tally/webhook, which maps the fields and generates the NDA.
# TALLY_SIGNING_SECRET gates the capability (verifies the webhook HMAC); absent => the webhook is a
# 503 stub (the generate intent still hands out the link). KV: tally-signing-secret.
# TALLY_SIGNING_SECRET=
# TALLY_FORM_ID=jagDPJ               # the "NDA Generator" form id (public link path)
# TALLY_BASE_URL=https://tally.so    # public form host; link is {base}/r/{form_id}
# FORM_BASE_URL: optional public base URL for absolute outbound links (e.g. password-reset emails).
#   No longer tied to any capability; unset => those links degrade to a relative path.
# FORM_BASE_URL=

# ---- DocuSign (capability: docusign — PLAN §3.9) ---------------------------
# Unlocks capability: docusign (envelope create + send via JWT-Grant, RS256). ALL FOUR of
# DOCUSIGN_ACCOUNT_ID / DOCUSIGN_INTEGRATION_KEY / DOCUSIGN_USER_ID / DOCUSIGN_PRIVATE_KEY are
# required; absent => the capability is DISABLED (the "Send via DocuSign" offer politely turns off).
# Demo host by default; production is a config change (base_uri + oauth_host).
# DOCUSIGN_BASE_URI=https://demo.docusign.net       # prod: https://<account-region>.docusign.net
# DOCUSIGN_OAUTH_HOST=account-d.docusign.com        # prod: account.docusign.com
# DOCUSIGN_ACCOUNT_ID=                              # the API account GUID
# DOCUSIGN_INTEGRATION_KEY=                         # the integration (client) key
# DOCUSIGN_USER_ID=                                 # the impersonated API user (JWT subject)
# DOCUSIGN_PRIVATE_KEY=                             # RS256 PEM (multiline). KV: docusign-private-key

# ---- Archive storage: Google Drive (capability: google_drive — PLAN §3.10) --
# Unlocks capability: google_drive (signed-NDA archive + the cache-folder watcher). The archive
# intent PDF-normalizes an attachment and uploads it to the CACHE folder; the worker's watcher then
# auto-names each drop and files it into the ARCHIVE folder. Auth is an offline-grant OAuth trio —
# the refresh token mints short-lived access tokens on demand. ALL THREE of GOOGLE_OAUTH_CLIENT_ID /
# GOOGLE_OAUTH_CLIENT_SECRET / GOOGLE_OAUTH_REFRESH_TOKEN plus DRIVE_ARCHIVE_FOLDER_ID are required;
# absent => the capability is DISABLED (archive + watcher politely turn off), never a boot error.
# GOOGLE_OAUTH_CLIENT_ID=                           # OAuth 2.0 client id (Google Cloud credential)
# GOOGLE_OAUTH_CLIENT_SECRET=                       # OAuth 2.0 client secret. KV: google-oauth-client-secret
# GOOGLE_OAUTH_REFRESH_TOKEN=                       # offline-grant refresh token. KV: google-oauth-refresh-token
# DRIVE_ARCHIVE_FOLDER_ID=                          # DESTINATION folder id for filed, auto-named signed NDAs ("Signed Company NDAs")
# DRIVE_CACHE_FOLDER_NAME=Signed Company NDAs Cache # the cache folder the watcher polls (resolved BY NAME)

# ---- Expiration tracker: Airtable (capability: airtable — PLAN §3.10) --------
# Unlocks capability: airtable (upsert of extracted NDA expiration dates — the expiration tracker,
# MINIMAL fields per §6). ALL THREE of AIRTABLE_PAT / AIRTABLE_BASE_ID / AIRTABLE_TABLE are required;
# absent => extraction still runs and logs but the upsert is a clean no-op (never a boot error).
# AIRTABLE_PAT=                                     # scoped Personal Access Token. KV: airtable-pat
# AIRTABLE_BASE_ID=                                 # the base id (appXXXXXXXXXXXXXX)
# AIRTABLE_TABLE=                                   # the expiration-tracker table name or id

# ---- Expiration extraction alias (PLAN §3.8, §3.10) -------------------------
# The `expiration` model alias is NOT an Anthropic path: the benchmark's winning contract is
# google/gemini-3.5-flash pinned to the google-vertex provider (file-parser plugin, native-PDF
# vision, strict YYYY-MM-DD|ERROR output). The adapter sends EXPIRATION_PROVIDER_ONLY as
# provider.only with allow_fallbacks=false + the ZDR policy. Do NOT relax the pin without re-running
# the expiration eval.
# OPENROUTER_MODEL_EXPIRATION=google/gemini-3.5-flash
# EXPIRATION_PROVIDER_ONLY=google-vertex            # comma-separated provider slugs; the benchmark pin

# ---- Watcher & expiration sweep cadence (PLAN §3.10; §5 old-bug fix) ---------
# WATCHER_INTERVAL_MINUTES: how often the worker's cache-folder watcher polls Drive. The OLD n8n
#   watcher effectively ran every 1 MINUTE (a misconfigured Schedule) though it claimed 5 — the
#   documented bug (§5). Default 5 is the INTENDED cadence (clamped to >=1).
# EXPIRATION_SWEEP_HOUR_UTC: UTC hour (0-23) for the nightly expiration sweep (re-extract + backfill
#   of NDAs missing an expiration date). Default 2 (02:00 UTC, a quiet window).
# WATCHER_INTERVAL_MINUTES=5
# EXPIRATION_SWEEP_HOUR_UTC=2
