<td data-local-id=3D"74f0c753" class=3D"confluenceTd">
<p local-id=3D"0c21bf12">SQL gate in separate erp-mcp process =C2=B7 proces=
s isolation</p></td>
<td data-local-id=3D"18228fb7" class=3D"confluenceTd">
<p local-id=3D"2dac09b4">Low (v1.5)</p></td>
</tr>
<tr data-local-id=3D"0c173d9a">
