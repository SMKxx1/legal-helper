<td data-local-id=3D"52403a0c" class=3D"confluenceTd">
<p local-id=3D"0ebfd2f9">LiteLLM per-user budget =C2=B7 60/hr =C2=B7 500/da=
y rate limits =C2=B7 monthly cap alarm</p></td>
<td data-local-id=3D"6d7485e2" class=3D"confluenceTd">
<p local-id=3D"3798c077">Low</p></td>
</tr>
<tr data-local-id=3D"71c09444">
<td data-local-id=3D"58fd70b9" class=3D"confluenceTd">
<p local-id=3D"1f90fa06">Cross-user data leak</p></td>
<td data-local-id=3D"549601d7" class=3D"confluenceTd">
